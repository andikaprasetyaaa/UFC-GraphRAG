# =============================================================
# Salin file ini menjadi ".env" lalu isi API key Gemini kamu.
#   cp .env.example .env
# Dapatkan API key gratis di: https://aistudio.google.com/apikey
# =============================================================

# Wajib
GOOGLE_API_KEY=isi_api_key_gemini_kamu_di_sini

# Opsional - model Gemini yang dipakai untuk chat/generasi jawaban
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Backend embedding lokal
EMBEDDING_BACKEND=sentence_transformers

# Model sentence-transformers untuk vektor FAISS dan semantic cache
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Opsional - lokasi file data mentah
CSV_PATH=data/master.csv

# Opsional - parameter retrieval
VECTOR_TOP_K=8
BM25_TOP_K=8
HYBRID_TOP_N=6
GRAPH_EXPAND_PER_FIGHTER=2
RRF_K=60

# Opsional - parameter semantic cache
SEMANTIC_CACHE_THRESHOLD=0.94
SEMANTIC_CACHE_MAX_ITEMS=1000
